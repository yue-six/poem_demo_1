{
  "version": 2,
  "builds": [
    {
      "src": "poem_demo/demo/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/poem_demo/demo/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/poem_demo/demo/index.html",
      "status": 200
    }
  ]
}